{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist/cjs",
    "module": "node16",
    "moduleResolution": "node16",
    "declaration": true,
    "declarationDir": "dist/cjs/types",
    "verbatimModuleSyntax": false,
    "noEmit": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/old"]
}
